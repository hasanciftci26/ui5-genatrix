<mvc:View xmlns:form2="sap.ui.layout.form"
    controllerName="ui5.genatrix.test.ui.v2.controller.Homepage"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:smartfilterbar="sap.ui.comp.smartfilterbar"
    xmlns:smarttable="sap.ui.comp.smarttable"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:form="ui5.genatrix.form"
>
    <Page
        id="Homepage"
        showHeader="false"
    >
        <content>
            <f:ShellBar
                id="sbHeader"
                title="UI5 Genatrix"
                homeIcon="img/app_logo.png"
                busyIndicatorDelay="0"
            >
                <f:profile>
                    <Avatar initials="GX" />
                </f:profile>
            </f:ShellBar>
            <FlexBox justifyContent="Center">
                <VBox width="95%">
                    <form2:SimpleForm columnsXL="1" columnsL="1" columnsM="1" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" layout="ResponsiveGridLayout">
                    <Label text="Test"></Label>
                    <Input ></Input>
                    </form2:SimpleForm>
                    <smartfilterbar:SmartFilterBar
                        id="sfbEmployees"
                        entitySet="Employees"
                        enableBasicSearch="true"
                        useProvidedNavigationProperties="true"
                    />
                    <smarttable:SmartTable
                        id="stEmployees"
                        entitySet="Employees"
                        smartFilterId="sfbEmployees"
                        tableType="Table"
                        header="Employees"
                        enableAutoBinding="true"
                        enableAutoColumnWidth="true"
                        enablePaste="false"
                        enableCopy="false"
                    >
                        <smarttable:customToolbar>
                            <OverflowToolbar>
                                <ToolbarSpacer />
                            </OverflowToolbar>
                        </smarttable:customToolbar>
                        <table:Table
                            selectionMode="Single"
                            selectionBehavior="Row"
                        >
                            <table:rowMode>
                                <rowmodes:Interactive rowCount="15" />
                            </table:rowMode>
                        </table:Table>
                    </smarttable:SmartTable>
                </VBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
