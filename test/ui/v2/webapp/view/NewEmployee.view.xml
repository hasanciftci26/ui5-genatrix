<mvc:View
    controllerName="ui5.genatrix.test.ui.v2.controller.NewEmployee"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="ui5.genatrix.form"
>
    <Page
        id="NewEmployee"
        showHeader="false"
    >
        <FlexBox justifyContent="Center">
            <VBox width="95%">
                <form:EmbeddedForm
                    id="frmTest"
                    entitySet="Employees"
                    title="My Form"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="3"
                    labelSpanS="3"
                    emptySpanXL="3"
                    emptySpanL="3"
                    emptySpanM="3"
                    emptySpanS="3"
                >
                    <form:propertyConstraints>
                        <form:PropertyConstraint
                            name="lastName"
                            type="Visible"
                        >
                            <form:PropertyConstraintRule
                                dependsOn="firstName"
                                comparisonOperator="EQ"
                                value1="Hasan"
                            />
                        </form:PropertyConstraint>                     
                    </form:propertyConstraints>
                </form:EmbeddedForm>
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
