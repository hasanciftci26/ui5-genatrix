<mvc:View
    controllerName="ui5.genatrix.test.ui.controller.NewEmployee"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="ui5.genatrix.form"
>
    <Page
        id="NewEmployee"
        showHeader="false"
    >
        <FlexBox justifyContent="Center">
            <VBox width="95%">
                <form:EmbeddedForm
                    id="efEmployees"
                    entitySet="Employees"
                    title="New Employee"
                    datePattern="dd MMMM y"
                    timePattern="HH:mm"
                    groupingSeparator="."
                    decimalSeparator=","
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="4"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="4"
                    emptySpanS="4"
                >
                    <form:propertyConstraints>
                        <form:PropertyConstraint
                            name="variableSalary"
                            type="Visible"
                        >
                            <form:PropertyConstraintRule
                                dependsOn="fixedSalary"
                                comparisonOperator="GT"
                                value1="0"
                            />
                        </form:PropertyConstraint>                     
                    </form:propertyConstraints>
                </form:EmbeddedForm>
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
