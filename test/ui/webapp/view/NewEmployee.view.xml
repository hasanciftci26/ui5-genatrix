<mvc:View
    controllerName="ui5.genatrix.test.ui.controller.NewEmployee"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="ui5.genatrix.form"
>
    <Page
        id="NewEmployee"
        showHeader="false"
    >
        <FlexBox justifyContent="Center">
            <VBox width="95%">
                <form:EmbeddedForm
                    id="efEmployees"
                    entitySet="Employees"
                    oDataModelName="v2"
                    title="New Employee"
                    datePattern="dd MMMM y"
                    timePattern="HH:mm"
                    groupingSeparator="."
                    decimalSeparator=","
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="4"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="4"
                    emptySpanS="4"
                    initialData="{
                        'countryCode': 'DE'
                    }"
                >
                    <form:customControls>
                        <form:CustomControl name="countryCode">
                            <Select selectedKey="{countryCode}">
                                <core:Item
                                    key="TR"
                                    text="Türkiye"
                                />
                                <core:Item
                                    key="DE"
                                    text="Germany"
                                />
                                <core:Item
                                    key="US"
                                    text="USA"
                                />
                            </Select>
                        </form:CustomControl>
                    </form:customControls>

                    <form:propertyConstraints>
                        <form:PropertyConstraint
                            name="variableSalary"
                            type="Visible"
                        >
                            <form:PropertyConstraintRule
                                dependsOn="fixedSalary"
                                comparisonOperator="GT"
                                value1="0"
                            />
                        </form:PropertyConstraint>
                    </form:propertyConstraints>

                    <form:propertyValidations>
                        <form:PropertyValidation
                            name="firstName"
                            value1="Hasan"
                        >
                            <form:PropertyValidationRule
                                dependsOn="lastName"
                                value1="Ciftci"
                            />
                        </form:PropertyValidation>
                    </form:propertyValidations>
                </form:EmbeddedForm>
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
